{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "AUTH_SECRET",
    "AUTH_DEBUG",
    "AUTH_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "AUTH_GOOGLE_ID",
    "AUTH_GOOGLE_SECRET",
    "AUTH_GITHUB_ID",
    "AUTH_GITHUB_SECRET",
    "DATABASE_URL",
    "DATABASE_POOL_MAX",
    "CASHFREE_ENV",
    "CASHFREE_CLIENT_ID",
    "CASHFREE_CLIENT_SECRET",
    "CASHFREE_WEBHOOK_SECRET",
    "CASHFREE_API_VERSION",
    "CASHFREE_PRO_PLAN_ID",
    "CASHFREE_TEAM_PLAN_ID",
    "CASHFREE_PRO_PLAN_TYPE",
    "CASHFREE_TEAM_PLAN_TYPE",
    "CASHFREE_AUTH_AMOUNT",
    "CASHFREE_AUTH_REFUND",
    "CASHFREE_AUTH_TIME_MIN",
    "BILLING_CHECKOUT_RETURN_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
