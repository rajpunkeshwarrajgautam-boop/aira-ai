// Auth models follow Auth.js Prisma adapter (PostgreSQL)
// https://authjs.dev/getting-started/adapters/prisma

generator client {
  provider = "prisma-client"
  output   = "../perplexity-clone/my-turborepo/apps/web/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BillingPlan {
  FREE
  PRO
  TEAM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

enum AnalyticsEventType {
  VISITOR_LANDED
  SIGNUP_COMPLETED
  SEARCH_STANDARD
  SEARCH_DEEP
  SHARE_CREATED
  UPGRADE_CHECKOUT_STARTED
  UPGRADE_COMPLETED
  QUOTA_EXCEEDED
  PLAN_REQUIRED
  SEARCH_ERROR
  ERROR_EVENT
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  TERMINATED
  REVIEW
}

enum AgentToolApprovalStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
  EXPIRED
}

enum ConversationMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum UserMemoryKind {
  PROFILE
  PREFERENCE
  GOAL
  PROJECT
  DECISION
  CONSTRAINT
  RELATIONSHIP
  OTHER
}

model User {
  id                   String                @id @default(cuid())
  name                 String?
  email                String?               @unique
  emailVerified        DateTime?
  image                String?
  /** E.164 or local digits — required for Cashfree subscription checkout when absent. */
  billingPhone         String?
  billingPlan          BillingPlan           @default(FREE)
  accounts             Account[]
  sessions             Session[]
  billingSubscription  BillingSubscription?
  usageRecords         UsageRecord[]
  agentRuns            AgentRun[]
  conversations        Conversation[]
  researchHistory      ResearchHistory[]
  memories             UserMemory[]
  mcpServerPreferences McpServerPreference[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Cashfree-backed subscription (one per user). Merchant `subscription_id` is unique per checkout.
model BillingSubscription {
  id                       String              @id @default(cuid())
  userId                   String              @unique
  user                     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** Cashfree `cf_subscription_id` (numeric string). */
  cfSubscriptionId         String              @unique
  /** Merchant reference passed to Cashfree `subscription_id`. */
  merchantSubscriptionId   String              @unique
  /** Cashfree dashboard `plan_id`. */
  cashfreePlanId           String
  plan                     BillingPlan
  status                   SubscriptionStatus
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  cancelAtPeriodEnd        Boolean             @default(false)
  teamSeats                Int                 @default(1)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
}

/// Monthly search usage (UTC calendar month), enforced per billing user.
model UsageRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart DateTime
  searches    Int      @default(0)
  agentRuns   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, periodStart])
}

/// A user-owned execution submitted to the autonomous agent runtimes.
/// Only provider identifiers and execution results are stored; API keys remain server-only.
model AgentRun {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String         @default("AUTOGPT")
  /// Client-generated idempotency key; prevents duplicate paid executions on retries.
  clientRequestId   String
  remoteExecutionId String?        @unique
  graphId           String
  graphVersion      Int
  objective         String         @db.Text
  status            AgentRunStatus @default(QUEUED)
  result            Json?
  errorMessage      String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  completedAt       DateTime?
  events            AgentRunEvent[]
  approvals         AgentToolApproval[]
  tasks             AgentRunTask[]
  messages          AgentRunMessage[]
  artifacts         AgentRunArtifact[]

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status, updatedAt(sort: Desc)])
}

/// Immutable, run-owned lifecycle facts surfaced in the Agent Run Center.
/// Ownership is inherited from AgentRun; direct Supabase Data API access remains denied.
model AgentRunEvent {
  id        String         @id @default(cuid())
  runId     String
  run       AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  eventKey  String
  type      String
  status    AgentRunStatus?
  message   String         @db.Text
  metadata  Json?
  createdAt DateTime       @default(now())

  @@unique([runId, eventKey])
  @@index([runId, createdAt])
}

/// Durable human authorization for a privileged agent tool action.
/// Creation is server-internal; users may only resolve approvals for runs they own.
model AgentToolApproval {
  id             String                  @id @default(cuid())
  runId          String
  run            AgentRun                @relation(fields: [runId], references: [id], onDelete: Cascade)
  approvalKey    String
  toolId         String
  permission     String
  mode           String
  summary        String                  @db.Text
  request        Json?
  status         AgentToolApprovalStatus @default(PENDING)
  requestedAt    DateTime                @default(now())
  resolvedAt     DateTime?
  resolverUserId String?

  @@unique([runId, approvalKey])
  @@index([runId, status, requestedAt])
  @@index([resolverUserId, resolvedAt])
}

/// Durable, scheduler-owned task state for an AIRA-managed run.
/// AgentRun remains the ownership boundary; no task row is directly exposed through Supabase Data API.
model AgentRunTask {
  id                 String    @id @default(cuid())
  runId              String
  run                AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  taskKey            String
  parentTaskKey      String?
  title              String
  description        String?   @db.Text
  role               String
  dependencies       String[]  @default([])
  requiredCapabilities String[] @default([])
  status             String
  priority           Int       @default(50)
  attempt            Int       @default(0)
  maxAttempts        Int?
  delegationDepth    Int       @default(1)
  blockedReason      String?   @db.Text
  expectedOutput     String?   @db.Text
  acceptanceCriteria Json?
  riskClass          String?
  preferredModelClass String?
  result             Json?
  evidence           Json?
  artifactRefs       Json?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([runId, taskKey])
  @@index([runId, status, priority(sort: Desc)])
  @@index([runId, role, updatedAt(sort: Desc)])
}

/// Bounded, structured communication between specialist agents during one run.
model AgentRunMessage {
  id            String   @id @default(cuid())
  runId         String
  run           AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  taskKey       String?
  senderRole    String
  recipientRole String?
  messageType   String
  content       String   @db.Text
  artifactRefs  Json?
  createdAt     DateTime @default(now())

  @@index([runId, createdAt])
  @@index([runId, taskKey, createdAt])
}

/// Run-owned artifact metadata. Binary payloads belong in bounded object/provider storage, not JSON event rows.
model AgentRunArtifact {
  id           String   @id @default(cuid())
  runId        String
  run          AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  taskKey      String?
  agentRole    String?
  type         String
  name         String
  storageRef   String   @db.Text
  contentType  String?
  sizeBytes    Int?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([runId, createdAt])
  @@index([runId, taskKey, createdAt])
}

/// User-owned activation preference for deployment-approved MCP servers.
/// Endpoints and credentials remain deployment/server configuration and are never stored here.
model McpServerPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, serverId])
  @@index([userId, updatedAt(sort: Desc)])
}

/// Cashfree PG webhook idempotency (SHA-256 hex of raw body after signature verification).
model ProcessedCashfreeWebhook {
  id          String   @id
  receivedAt  DateTime @default(now())
}

model Conversation {
  id                  String                @id @default(cuid())
  userId              String
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  archivedAt          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  lastMessageAt       DateTime              @default(now())
  summary             String?               @db.Text
  summaryUpdatedAt    DateTime?
  summaryMessageCount Int                   @default(0)
  messages            ConversationMessage[]
  researchLogs        ResearchHistory[]
  sourcedMemories     UserMemory[]           @relation("MemorySourceConversation")

  @@index([userId, lastMessageAt(sort: Desc)])
}

model ConversationMessage {
  id               String                  @id @default(cuid())
  conversationId   String
  conversation     Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId           String
  role             ConversationMessageRole
  content          String                  @db.Text
  parentMessageId  String?
  parentMessage    ConversationMessage?    @relation("ConversationMessageThread", fields: [parentMessageId], references: [id], onDelete: SetNull)
  childMessages    ConversationMessage[]   @relation("ConversationMessageThread")
  citations        Json?
  metadata         Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  researchLogs     ResearchHistory[]
  sourcedMemories  UserMemory[]            @relation("MemorySourceMessage")

  @@index([conversationId, createdAt])
  @@index([conversationId, parentMessageId])
  @@index([userId, createdAt(sort: Desc)])
}

model UserMemory {
  id                   String               @id @default(cuid())
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryKey            String
  kind                 UserMemoryKind       @default(OTHER)
  content              String               @db.Text
  keywords             String[]             @default([])
  importance           Int                  @default(3)
  confidence           Float                @default(1)
  pinned               Boolean              @default(false)
  sourceConversationId String?
  sourceConversation   Conversation?        @relation("MemorySourceConversation", fields: [sourceConversationId], references: [id], onDelete: SetNull)
  sourceMessageId      String?
  sourceMessage        ConversationMessage? @relation("MemorySourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  lastRecalledAt       DateTime?
  recallCount          Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([userId, memoryKey])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, kind])
  @@index([userId, pinned(sort: Desc), updatedAt(sort: Desc)])
  @@index([sourceConversationId])
  @@index([sourceMessageId])
}

model ResearchHistory {
  id                String               @id @default(cuid())
  userId            String
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId    String?
  conversation      Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageId         String?
  message           ConversationMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  query             String
  normalizedQuery   String
  assistantAnswer   String               @db.Text
  citationCount     Int                  @default(0)
  citations         Json?
  exaRequestId      String?
  exaSearchType     String?
  /** Opaque token used for public share pages. Must never be guessable. */
  publicShareToken String?               @unique
  createdAt         DateTime             @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([normalizedQuery, createdAt(sort: Desc)])
}

model AnalyticsVisitorState {
  anonymousId   String   @id
  firstLandedAt DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AnalyticsSignupState {
  userId      String   @id
  anonymousId String?
  signupAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnalyticsEvent {
  id        String             @id @default(cuid())
  type      AnalyticsEventType
  /** UTC day boundary for fast day-level aggregation. */
  eventDay  DateTime
  createdAt DateTime           @default(now())

  anonymousId String?
  userId      String?
  plan        BillingPlan?
  metadata    Json?

  @@index([eventDay])
  @@index([type, eventDay])
  @@index([anonymousId, eventDay])
  @@index([userId, eventDay])
}

model ProductAnalyticsEvent {
  id             String   @id @default(cuid())
  event          String
  surface        String?
  userType       String?
  queryLength    Int?
  sourceCount    Int?
  citationCount  Int?
  citationIndex  Int?
  sourceDomain   String?
  conversationId String?
  messageId      String?
  errorCode      String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([event, createdAt])
  @@index([userType, createdAt])
  @@index([surface, createdAt])
}
