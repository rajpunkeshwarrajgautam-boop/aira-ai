# =============================================================================
# REQUIRED. AIRA does not start, or its core research path does not work,
# without these. Every value below is server-only unless the name begins with
# NEXT_PUBLIC_. Never commit real values to this file.
# =============================================================================

DATABASE_URL=
DATABASE_POOL_MAX=

AUTH_SECRET=
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

EXA_API_KEY=

AUTH_URL=https://aira-ai-live.vercel.app
NEXTAUTH_URL=https://aira-ai-live.vercel.app
NEXT_PUBLIC_FEEDBACK_EMAIL=

# =============================================================================
# Core behaviour. These have working defaults; set them to override.
# =============================================================================

DEFAULT_PRO_PROVIDER=openai
DEFAULT_FREE_PROVIDER=nvidia
ANONYMOUS_DAILY_SEARCH_LIMIT=2
AGENTIC_DEEP_RESEARCH_ENABLED=
ANALYTICS_ADMIN_EMAIL=
ANALYTICS_ADMIN_EMAILS=
AUTH_DEBUG=false

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_CHAT_MODEL_FALLBACKS=meta/llama-3.3-70b-instruct,minimaxai/minimax-m3

# Virexa Local AI Engine / llama.cpp.
VIREXA_LOCAL_AI_ENABLED=false
SELF_HOSTED_LLM_BASE_URL=
SELF_HOSTED_LLM_API_KEY=
SELF_HOSTED_LLM_MODEL=
VIREXA_LOCAL_AI_TIMEOUT_MS=45000
VIREXA_LOCAL_AI_MAX_TOKENS=1600
AIRA_LOCAL_FIRST_ENABLED=false
AIRA_LOCAL_AI_REQUIRED=false

# Tier-aware semantic memory.
SEMANTIC_MEMORY_ENABLED=false
AIRA_FREE_EMBEDDING_PROVIDER=self-hosted
AIRA_FREE_EMBEDDING_BASE_URL=
AIRA_FREE_EMBEDDING_API_KEY=
AIRA_FREE_EMBEDDING_MODEL=nomic-embed-text-v1.5
AIRA_FREE_EMBEDDING_DIMENSIONS=768
AIRA_PRO_EMBEDDING_PROVIDER=openai
AIRA_PRO_EMBEDDING_BASE_URL=
AIRA_PRO_EMBEDDING_API_KEY=
AIRA_PRO_EMBEDDING_MODEL=text-embedding-3-small
AIRA_PRO_EMBEDDING_DIMENSIONS=768
AIRA_EMBEDDING_MODEL=
AIRA_EMBEDDING_API_KEY=
AIRA_EMBEDDING_BASE_URL=
GRAPH_MEMORY_ENABLED=false
MEMORY_CONSOLIDATION_ENABLED=false
ADAPTIVE_REASONING_ENABLED=false

# Optional self-hosted safety gateway.
AIRA_SAFETY_GATEWAY_ENABLED=false
AIRA_SAFETY_GATEWAY_REQUIRED=false
AIRA_SAFETY_GATEWAY_MODE=observe
AIRA_SAFETY_GATEWAY_URL=
AIRA_SAFETY_GATEWAY_TOKEN=
AIRA_SAFETY_GATEWAY_TIMEOUT_MS=1200
AIRA_POST_INFERENCE_SAFETY_ENABLED=false

AIRA_DATA_RESIDENCY_ENFORCED=false
AIRA_REQUIRE_LOCAL_INFERENCE=false
AIRA_ALLOWED_INFERENCE_REGIONS=
AIRA_PROVIDER_REGIONS_JSON={}

# Foundation control plane / distributed admission and provider health.
FOUNDATION_CONTROL_PLANE_ENABLED=false
FOUNDATION_CONTROL_PLANE_REQUIRED=false
AIRA_CONTROL_PLANE_URL=
AIRA_CONTROL_PLANE_TOKEN=
AIRA_CONTROL_PLANE_TIMEOUT_MS=1500

# Isolated Python execution.
PYTHON_SANDBOX_ENABLED=false
AIRA_SANDBOX_URL=
AIRA_SANDBOX_TOKEN=

# Uploaded document/image knowledge ingestion.
MULTIMODAL_INGESTION_ENABLED=false
ADVANCED_MULTIMODAL_ENABLED=false
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AIRA_KNOWLEDGE_BUCKET=aira-knowledge
AIRA_KNOWLEDGE_WORKER_TOKEN=
AIRA_MEDIA_BASE_URL=
AIRA_MEDIA_API_KEY=
AIRA_MEDIA_MODEL=

# Cashfree Subscriptions. Keep keys server-only in Vercel.
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2026-01-01
CASHFREE_PLAN_CURRENCY=USD
CASHFREE_PRO_MONTHLY_AMOUNT=20
CASHFREE_TEAM_SEAT_MONTHLY_AMOUNT=15
CASHFREE_PLAN_MAX_CYCLES=120
CASHFREE_AUTH_REFUND=false
BILLING_CHECKOUT_RETURN_URL=https://aira-ai-live.vercel.app

# DeerFlow 2.0 long-horizon SuperAgent Gateway.
DEERFLOW_AGENT_ENABLED=false
DEERFLOW_API_BASE_URL=https://deerflow.example.com
DEERFLOW_INTERNAL_AUTH_TOKEN=
DEERFLOW_MODEL_NAME=
DEERFLOW_THINKING_ENABLED=false
DEERFLOW_PLAN_MODE=true
DEERFLOW_REQUEST_TIMEOUT_MS=15000
DEERFLOW_HEALTH_TIMEOUT_MS=2500

# Self-hosted AutoGPT runners.
AUTOGPT_API_BASE_URL=
AUTOGPT_API_KEY=
AUTOGPT_AGENT_ENABLED=false
AUTOGPT_REQUIRE_FOUNDATION_STACK=true
AUTOGPT_PRIMARY_API_BASE_URL=https://autogpt-primary.example.com/external-api/v1
AUTOGPT_PRIMARY_API_KEY=
AUTOGPT_SECONDARY_API_BASE_URL=https://autogpt-secondary.example.com/external-api/v1
AUTOGPT_SECONDARY_API_KEY=
AUTOGPT_GRAPH_ID=aira-objective-runner
AUTOGPT_GRAPH_VERSION=1
AUTOGPT_INPUT_NODE_ID=objective
AUTOGPT_INPUT_FIELD=value
AUTOGPT_REQUEST_TIMEOUT_MS=15000
AUTOGPT_HEALTH_TIMEOUT_MS=2000

# Provider-neutral autonomous runtime selection. Agent Swarm is optional and is
# never selected until it is enabled, configured and healthy. Keep tokens server-only.
AIRA_AGENT_RUNTIME_PRIORITY=DEERFLOW,AUTOGPT,AGENT_SWARM
AGENT_SWARM_ENABLED=false
AGENT_SWARM_BASE_URL=https://agent-swarm.example.com
AGENT_SWARM_API_TOKEN=
AGENT_SWARM_TIMEOUT_MS=8000
AGENT_SWARM_MODEL_TIER=regular

# Isolated real-browser execution. The web app is only the control plane; this
# points to the dedicated Chromium worker behind the AIRA TLS edge. The worker
# rejects private-network destinations, enforces session domain allowlists and
# requires its bearer token for every state-changing/read-session operation.
AIRA_BROWSER_RUNTIME_ENABLED=false
AIRA_BROWSER_RUNTIME_URL=https://browser.example.com
AIRA_BROWSER_RUNTIME_TOKEN=
AIRA_BROWSER_RUNTIME_TIMEOUT_MS=12000
# Worker-host values; do not expose these to the browser/client bundle.
AIRA_BROWSER_MAX_SESSIONS=6
AIRA_BROWSER_SESSION_TTL_SECONDS=3600
AIRA_BROWSER_PORT=8092
AIRA_BROWSER_HOST=browser.example.com

# Offline model-training execution is intentionally not a web/Vercel feature flag.
AIRA_TRAINING_EXECUTION_APPROVED=false
