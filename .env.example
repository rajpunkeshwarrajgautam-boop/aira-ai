# =============================================================================
# REQUIRED. AIRA does not start, or its core research path does not work,
# without these. Every value below is server-only unless the name begins with
# NEXT_PUBLIC_. Never commit real values to this file.
# =============================================================================

# PostgreSQL connection string for Prisma (the Supabase production database in
# production). The app throws on first query if this is unset.
DATABASE_URL=
# Optional. Upper bound on the pg connection pool. Defaults to a safe small value.
DATABASE_POOL_MAX=

# Auth.js session signing key: at least 32 characters. AIRA refuses to boot in
# production if this is missing or too short. AUTH_SECRET is the modern name;
# NEXTAUTH_SECRET is the legacy alias and either is accepted.
AUTH_SECRET=
NEXTAUTH_SECRET=

# At least one OAuth provider pair is required in production, or AIRA refuses to
# boot. Both classic and AUTH_* alias names are accepted for each provider; set
# one name per value, not both. Callback URL is <AUTH_URL>/api/auth/callback/<provider>.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Aliases, equivalent to the four names above.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Exa web retrieval. Without it every grounded research query fails: this is the
# source of all citations, not an optional enhancement.
EXA_API_KEY=

# Public application URL used by Auth.js and billing callbacks. Must be the
# canonical production origin, or OAuth callbacks land on the wrong domain.
AUTH_URL=https://aira-ai-live.vercel.app
NEXTAUTH_URL=https://aira-ai-live.vercel.app
NEXT_PUBLIC_FEEDBACK_EMAIL=

# =============================================================================
# Core behaviour. These have working defaults; set them to override.
# =============================================================================

# Answer-provider routing. Values are provider ids registered in the provider
# router. Defaults: pro=openai, free=nvidia.
DEFAULT_PRO_PROVIDER=openai
DEFAULT_FREE_PROVIDER=nvidia

# Daily grounded searches allowed to a signed-out visitor. Defaults to 2.
ANONYMOUS_DAILY_SEARCH_LIMIT=2

# Agentic deep-research workflow. Leave unset to use the built-in default.
AGENTIC_DEEP_RESEARCH_ENABLED=

# Analytics/admin access. Set one address, or a comma-separated list. Only these
# accounts may read /admin/analytics and its API routes.
ANALYTICS_ADMIN_EMAIL=
ANALYTICS_ADMIN_EMAILS=

# Verbose Auth.js diagnostics. Never enable in production: it increases the
# amount of authentication detail written to logs.
AUTH_DEBUG=false

# AI answer providers. NVIDIA uses the first accessible model before failing.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_CHAT_MODEL_FALLBACKS=meta/llama-3.3-70b-instruct,minimaxai/minimax-m3

# Virexa Local AI Engine / llama.cpp.
# Keep disabled by default until a real local/private endpoint passes the health check.
# SELF_HOSTED_LLM_BASE_URL should normally end in /v1, for example http://127.0.0.1:8080/v1
# when AIRA itself is running on the same Windows PC. llama.cpp does not require an API key
# unless you start llama-server with one, so SELF_HOSTED_LLM_API_KEY may remain blank.
# A public Vercel deployment cannot reach your PC's 127.0.0.1; use an authenticated private
# HTTPS bridge/tunnel or run the AIRA web/desktop process on the same machine as llama.cpp.
VIREXA_LOCAL_AI_ENABLED=false
SELF_HOSTED_LLM_BASE_URL=
SELF_HOSTED_LLM_API_KEY=
SELF_HOSTED_LLM_MODEL=
VIREXA_LOCAL_AI_TIMEOUT_MS=45000
VIREXA_LOCAL_AI_MAX_TOKENS=1600
# Selective is the default: routine extraction/classification/summary/business-worker jobs use
# local inference, while web/fresh/high-stakes/large coding work stays on stronger providers.
AIRA_LOCAL_FIRST_ENABLED=false
# When true, a local-eligible job fails instead of falling back to a cloud provider.
AIRA_LOCAL_AI_REQUIRED=false

# Tier-aware semantic memory. Keep disabled until Preview proves the complete
# FREE write/query path and controlled provider failure produces lexical fallback.
# FREE uses Cloudflare Workers AI through its OpenAI-compatible /ai/v1 base URL.
# Replace <ACCOUNT_ID> in deployment configuration; never commit the account token.
# Workers AI's Free plan currently includes 10,000 neurons/day. Exhaustion must
# degrade to lexical memory; FREE never falls through to the paid semantic route.
SEMANTIC_MEMORY_ENABLED=false
AIRA_FREE_EMBEDDING_PROVIDER=cloudflare
AIRA_FREE_EMBEDDING_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
AIRA_FREE_EMBEDDING_API_KEY=
AIRA_FREE_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
AIRA_FREE_EMBEDDING_DIMENSIONS=768
# PRO and TEAM use the richer dedicated embedding route. Keep this credential separate from
# OPENAI_API_KEY so semantic-memory usage cannot silently consume the chat-generation account.
AIRA_PRO_EMBEDDING_PROVIDER=openai
AIRA_PRO_EMBEDDING_BASE_URL=
AIRA_PRO_EMBEDDING_API_KEY=
AIRA_PRO_EMBEDDING_MODEL=text-embedding-3-small
AIRA_PRO_EMBEDDING_DIMENSIONS=768
# Legacy semantic embedding names are accepted only as a PRO/TEAM compatibility alias.
# They are never read by the FREE route. Prefer the explicit AIRA_PRO_* names above.
AIRA_EMBEDDING_MODEL=
AIRA_EMBEDDING_API_KEY=
AIRA_EMBEDDING_BASE_URL=

# Graph-relational memory. Keep off until the additive graph migration is verified and
# a reviewed extraction/consolidation job exists. UserMemory remains canonical.
GRAPH_MEMORY_ENABLED=false
MEMORY_CONSOLIDATION_ENABLED=false

# Optional adaptive compute policy. This never publishes private chain-of-thought.
ADAPTIVE_REASONING_ENABLED=false

# Optional self-hosted safety gateway. Start in observe mode; enforce only after false-positive testing.
AIRA_SAFETY_GATEWAY_ENABLED=false
AIRA_SAFETY_GATEWAY_REQUIRED=false
AIRA_SAFETY_GATEWAY_MODE=observe
AIRA_SAFETY_GATEWAY_URL=
AIRA_SAFETY_GATEWAY_TOKEN=
AIRA_SAFETY_GATEWAY_TIMEOUT_MS=1200
AIRA_POST_INFERENCE_SAFETY_ENABLED=false

# Optional inference-placement policy. When enforced, providers with missing/undeclared regions are rejected.
AIRA_DATA_RESIDENCY_ENFORCED=false
AIRA_REQUIRE_LOCAL_INFERENCE=false
AIRA_ALLOWED_INFERENCE_REGIONS=
AIRA_PROVIDER_REGIONS_JSON={}

# Foundation control plane / distributed admission and provider health.
# Keep REQUIRED=false during initial rollout so normal chat can degrade to the existing local path.
FOUNDATION_CONTROL_PLANE_ENABLED=false
FOUNDATION_CONTROL_PLANE_REQUIRED=false
AIRA_CONTROL_PLANE_URL=
AIRA_CONTROL_PLANE_TOKEN=
AIRA_CONTROL_PLANE_TIMEOUT_MS=1500

# Isolated Python execution. Only enable after the external sandbox service passes resource/network isolation tests.
PYTHON_SANDBOX_ENABLED=false
AIRA_SANDBOX_URL=
AIRA_SANDBOX_TOKEN=

# Uploaded document/image knowledge ingestion. Requires private object storage, the control plane,
# an ingestion worker, callback token, and semantic memory. Images additionally require a vision endpoint.
MULTIMODAL_INGESTION_ENABLED=false
ADVANCED_MULTIMODAL_ENABLED=false
SUPABASE_URL=
# Alias accepted by the storage helper when SUPABASE_URL is unset. Only the project
# URL may ever carry a NEXT_PUBLIC_ prefix; the service-role key must never be public.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AIRA_KNOWLEDGE_BUCKET=aira-knowledge
AIRA_KNOWLEDGE_WORKER_TOKEN=
AIRA_MEDIA_BASE_URL=
AIRA_MEDIA_API_KEY=
AIRA_MEDIA_MODEL=

# Cashfree Subscriptions. Keep keys server-only in Vercel.
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Cashfree signs subscription webhooks with the same sandbox secret key.
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2026-01-01
CASHFREE_PLAN_CURRENCY=USD
CASHFREE_PRO_MONTHLY_AMOUNT=20
CASHFREE_TEAM_SEAT_MONTHLY_AMOUNT=15
CASHFREE_PLAN_MAX_CYCLES=120
CASHFREE_AUTH_REFUND=false
BILLING_CHECKOUT_RETURN_URL=https://aira-ai-live.vercel.app

# DeerFlow 2.0 long-horizon SuperAgent Gateway. AIRA prefers DeerFlow when it is enabled
# and fully configured, while retaining the AutoGPT adapter as a fallback runtime.
# The endpoint must be the DeerFlow Gateway root (health at /health, native API at /api/*)
# exposed through TLS. DEERFLOW_INTERNAL_AUTH_TOKEN must equal DeerFlow's
# DEER_FLOW_INTERNAL_AUTH_TOKEN and must remain server-only.
DEERFLOW_AGENT_ENABLED=false
DEERFLOW_API_BASE_URL=https://deerflow.example.com
DEERFLOW_INTERNAL_AUTH_TOKEN=
DEERFLOW_MODEL_NAME=
DEERFLOW_THINKING_ENABLED=false
DEERFLOW_PLAN_MODE=true
DEERFLOW_REQUEST_TIMEOUT_MS=15000
DEERFLOW_HEALTH_TIMEOUT_MS=2500

# Self-hosted AutoGPT runners. Production configuration requires both distinct HTTPS targets.
# Keep disabled until both health checks pass and a real primary-down / secondary-up failover drill passes.
# AUTOGPT_API_BASE_URL / AUTOGPT_API_KEY are the legacy single-host names; the adapter
# still reads them when no PRIMARY/SECONDARY pair is configured. Prefer the dual-host names.
AUTOGPT_API_BASE_URL=
AUTOGPT_API_KEY=
AUTOGPT_AGENT_ENABLED=false
AUTOGPT_REQUIRE_FOUNDATION_STACK=true
AUTOGPT_PRIMARY_API_BASE_URL=https://autogpt-primary.example.com/external-api/v1
AUTOGPT_PRIMARY_API_KEY=
AUTOGPT_SECONDARY_API_BASE_URL=https://autogpt-secondary.example.com/external-api/v1
AUTOGPT_SECONDARY_API_KEY=
AUTOGPT_GRAPH_ID=aira-objective-runner
AUTOGPT_GRAPH_VERSION=1
AUTOGPT_INPUT_NODE_ID=objective
AUTOGPT_INPUT_FIELD=value
AUTOGPT_REQUEST_TIMEOUT_MS=15000
AUTOGPT_HEALTH_TIMEOUT_MS=2000

# Offline model-training execution is intentionally not a web/Vercel feature flag.
# Set this only on an approved GPU training host for an explicitly reviewed run.
AIRA_TRAINING_EXECUTION_APPROVED=false