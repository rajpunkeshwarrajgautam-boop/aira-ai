# Public application URL used by Auth.js and billing callbacks.
AUTH_URL=https://aira-ai-live.vercel.app
NEXTAUTH_URL=https://aira-ai-live.vercel.app
NEXT_PUBLIC_FEEDBACK_EMAIL=

# AI answer providers. NVIDIA uses the first accessible model before failing.
OPENAI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_CHAT_MODEL_FALLBACKS=meta/llama-3.3-70b-instruct,minimaxai/minimax-m3

# Optional self-hosted OpenAI-compatible inference. Do not select it as a default provider
# until a real GPU host has passed fabric validation, health checks, and canary load tests.
SELF_HOSTED_LLM_BASE_URL=
SELF_HOSTED_LLM_API_KEY=
SELF_HOSTED_LLM_MODEL=

# Semantic memory. The vector migration must exist before enabling this flag.
SEMANTIC_MEMORY_ENABLED=false
AIRA_EMBEDDING_MODEL=text-embedding-3-small
AIRA_EMBEDDING_API_KEY=
AIRA_EMBEDDING_BASE_URL=

# Graph-relational memory. Keep off until the additive graph migration is verified and
# a reviewed extraction/consolidation job exists. UserMemory remains canonical.
GRAPH_MEMORY_ENABLED=false
MEMORY_CONSOLIDATION_ENABLED=false

# Optional adaptive compute policy. This never publishes private chain-of-thought.
ADAPTIVE_REASONING_ENABLED=false

# Optional self-hosted safety gateway. Start in observe mode; enforce only after false-positive testing.
AIRA_SAFETY_GATEWAY_ENABLED=false
AIRA_SAFETY_GATEWAY_REQUIRED=false
AIRA_SAFETY_GATEWAY_MODE=observe
AIRA_SAFETY_GATEWAY_URL=
AIRA_SAFETY_GATEWAY_TOKEN=
AIRA_SAFETY_GATEWAY_TIMEOUT_MS=1200
AIRA_POST_INFERENCE_SAFETY_ENABLED=false

# Optional inference-placement policy. When enforced, providers with missing/undeclared regions are rejected.
AIRA_DATA_RESIDENCY_ENFORCED=false
AIRA_REQUIRE_LOCAL_INFERENCE=false
AIRA_ALLOWED_INFERENCE_REGIONS=
AIRA_PROVIDER_REGIONS_JSON={}

# Foundation control plane / distributed admission and provider health.
# Keep REQUIRED=false during initial rollout so normal chat can degrade to the existing local path.
FOUNDATION_CONTROL_PLANE_ENABLED=false
FOUNDATION_CONTROL_PLANE_REQUIRED=false
AIRA_CONTROL_PLANE_URL=
AIRA_CONTROL_PLANE_TOKEN=
AIRA_CONTROL_PLANE_TIMEOUT_MS=1500

# Isolated Python execution. Only enable after the external sandbox service passes resource/network isolation tests.
PYTHON_SANDBOX_ENABLED=false
AIRA_SANDBOX_URL=
AIRA_SANDBOX_TOKEN=

# Uploaded document/image knowledge ingestion. Requires private object storage, the control plane,
# an ingestion worker, callback token, and semantic memory. Images additionally require a vision endpoint.
MULTIMODAL_INGESTION_ENABLED=false
ADVANCED_MULTIMODAL_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AIRA_KNOWLEDGE_BUCKET=aira-knowledge
AIRA_KNOWLEDGE_WORKER_TOKEN=
AIRA_MEDIA_BASE_URL=
AIRA_MEDIA_API_KEY=
AIRA_MEDIA_MODEL=

# Cashfree Subscriptions. Keep keys server-only in Vercel.
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Cashfree signs subscription webhooks with the same sandbox secret key.
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2026-01-01
CASHFREE_PLAN_CURRENCY=USD
CASHFREE_PRO_MONTHLY_AMOUNT=20
CASHFREE_TEAM_SEAT_MONTHLY_AMOUNT=15
CASHFREE_PLAN_MAX_CYCLES=120
CASHFREE_AUTH_REFUND=false
BILLING_CHECKOUT_RETURN_URL=https://aira-ai-live.vercel.app

# DeerFlow 2.0 long-horizon SuperAgent Gateway. AIRA prefers DeerFlow when it is enabled
# and fully configured, while retaining the AutoGPT adapter as a fallback runtime.
# The endpoint must be the DeerFlow Gateway root (health at /health, native API at /api/*)
# exposed through TLS. DEERFLOW_INTERNAL_AUTH_TOKEN must equal DeerFlow's
# DEER_FLOW_INTERNAL_AUTH_TOKEN and must remain server-only.
DEERFLOW_AGENT_ENABLED=false
DEERFLOW_API_BASE_URL=https://deerflow.example.com
DEERFLOW_INTERNAL_AUTH_TOKEN=
DEERFLOW_MODEL_NAME=
DEERFLOW_THINKING_ENABLED=false
DEERFLOW_PLAN_MODE=true
DEERFLOW_REQUEST_TIMEOUT_MS=15000
DEERFLOW_HEALTH_TIMEOUT_MS=2500

# Self-hosted AutoGPT runners. Production configuration requires both distinct HTTPS targets.
# Keep disabled until both health checks pass and a real primary-down / secondary-up failover drill passes.
AUTOGPT_AGENT_ENABLED=false
AUTOGPT_REQUIRE_FOUNDATION_STACK=true
AUTOGPT_PRIMARY_API_BASE_URL=https://autogpt-primary.example.com/external-api/v1
AUTOGPT_PRIMARY_API_KEY=
AUTOGPT_SECONDARY_API_BASE_URL=https://autogpt-secondary.example.com/external-api/v1
AUTOGPT_SECONDARY_API_KEY=
AUTOGPT_GRAPH_ID=aira-objective-runner
AUTOGPT_GRAPH_VERSION=1
AUTOGPT_INPUT_NODE_ID=objective
AUTOGPT_INPUT_FIELD=value
AUTOGPT_REQUEST_TIMEOUT_MS=15000
AUTOGPT_HEALTH_TIMEOUT_MS=2000

# Offline model-training execution is intentionally not a web/Vercel feature flag.
# Set this only on an approved GPU training host for an explicitly reviewed run.
AIRA_TRAINING_EXECUTION_APPROVED=false
