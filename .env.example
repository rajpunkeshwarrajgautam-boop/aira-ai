# Public application URL used by Auth.js and billing callbacks.
AUTH_URL=https://aira-ai-live.vercel.app
NEXTAUTH_URL=https://aira-ai-live.vercel.app
NEXT_PUBLIC_FEEDBACK_EMAIL=

# AI answer providers. NVIDIA uses the first accessible model before failing.
OPENAI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_CHAT_MODEL_FALLBACKS=meta/llama-3.3-70b-instruct,minimaxai/minimax-m3

# Cashfree Subscriptions. Keep keys server-only in Vercel.
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Cashfree signs subscription webhooks with the same sandbox secret key.
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2026-01-01
CASHFREE_PLAN_CURRENCY=USD
CASHFREE_PRO_MONTHLY_AMOUNT=20
CASHFREE_TEAM_SEAT_MONTHLY_AMOUNT=15
CASHFREE_PLAN_MAX_CYCLES=120
CASHFREE_AUTH_REFUND=false
BILLING_CHECKOUT_RETURN_URL=https://aira-ai-live.vercel.app

# AutoGPT Platform External API. Keep the key server-only and grant only
# EXECUTE_GRAPH and READ_GRAPH permissions.
AUTOGPT_AGENT_ENABLED=false
AUTOGPT_API_BASE_URL=https://your-autogpt-host.example/external-api/v1
AUTOGPT_API_KEY=
AUTOGPT_GRAPH_ID=
AUTOGPT_GRAPH_VERSION=1
AUTOGPT_INPUT_NODE_ID=
AUTOGPT_INPUT_FIELD=value
AUTOGPT_REQUEST_TIMEOUT_MS=15000
