{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aira.ai/schemas/model-lab/dataset-manifest.schema.json",
  "title": "AIRA model dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "purpose",
    "status",
    "source",
    "license",
    "permitted_use",
    "private_data",
    "training_allowed",
    "contamination_check",
    "provenance"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["planned", "smoke", "candidate", "frozen", "retired"]
    },
    "source": { "type": "string", "minLength": 1 },
    "version": { "type": ["string", "null"] },
    "license": { "type": "string", "minLength": 1 },
    "permitted_use": { "type": "string", "minLength": 1 },
    "collection_date": { "type": ["string", "null"], "format": "date" },
    "example_count": { "type": ["integer", "null"], "minimum": 0 },
    "token_count": { "type": ["integer", "null"], "minimum": 0 },
    "languages": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "domains": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "quality_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "deduplication": { "type": ["string", "null"] },
    "private_data": { "type": "boolean" },
    "training_allowed": { "type": "boolean" },
    "contamination_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method"],
      "properties": {
        "status": { "type": "string", "enum": ["not_run", "pass", "fail"] },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference"],
        "properties": {
          "kind": { "type": "string", "enum": ["synthetic", "public_dataset", "internal_authored", "derived"] },
          "reference": { "type": "string", "minLength": 1 },
          "revision": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "inclusion_rationale": { "type": ["string", "null"] }
  }
}
