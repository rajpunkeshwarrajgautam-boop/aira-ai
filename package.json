{
	"packageManager": "pnpm@10.28.1",
	"scripts": {
		"build": "turbo run build --filter=web",
		"lint": "turbo run lint --filter=web",
		"check-types": "turbo run check-types --filter=web",
		"audit:prod": "pnpm audit --prod",
		"test": "turbo run test --filter=web",
		"ci": "pnpm run verify:migrations && pnpm run audit:prod && pnpm run lint && pnpm run check-types && pnpm run test && pnpm run build",
		"verify:migrations": "node scripts/db/verify-migration-bytes.mjs",
		"worker:dev": "pnpm --filter=web worker:dev",
		"worker:start": "pnpm --filter=web worker:start"
	},
	"devDependencies": {
		"dotenv": "^17.4.2",
		"prisma": "^7.9.1",
		"turbo": "^2.9.6"
	}
}
