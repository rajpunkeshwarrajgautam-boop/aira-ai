{
	"packageManager": "pnpm@10.28.1",
	"scripts": {
		"build": "turbo run build --filter=web",
		"lint": "turbo run lint --filter=web",
		"check-types": "turbo run check-types --filter=web",
		"audit:prod": "pnpm audit --prod",
		"ci": "pnpm run audit:prod && pnpm run lint && pnpm run check-types && pnpm run build"
	},
	"devDependencies": {
		"dotenv": "^17.4.2",
		"prisma": "^7.9.0",
		"turbo": "^2.9.6"
	}
}
