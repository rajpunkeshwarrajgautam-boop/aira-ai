# Copy to terraform.tfvars and replace the placeholders. terraform.tfvars is
# gitignored. Never place OCI API private keys in this file.

compartment_ocid = "ocid1.compartment.oc1..replace-me"
ssh_public_key    = "ssh-ed25519 replace-me operator@example"

# Restrict SSH to your current public IPv4 /32 or another trusted admin range.
admin_ipv4_cidrs = ["203.0.113.50/32"]

# Defaults intentionally use half of the currently documented OCI Always Free
# Ampere A1 CPU/RAM equivalent.
instance_ocpus    = 1
instance_memory_gb = 6
boot_volume_gb    = 50

# If the first availability domain has no A1 capacity, set another AD explicitly
# rather than changing to a billable shape.
availability_domain = ""
