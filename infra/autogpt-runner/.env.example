# Shared runner settings. Use different RUNNER_API_KEY and AUTOGPT_INTERNAL_TOKEN
# values on the VPS and Windows host.
RUNNER_API_KEY=
AUTOGPT_INTERNAL_TOKEN=sk-
NVIDIA_API_KEY=

AIRA_GRAPH_ID=aira-objective-runner
AIRA_GRAPH_VERSION=1
AUTOGPT_MAX_STEPS=12
AUTOGPT_MAX_CONCURRENT_RUNS=1
AUTOGPT_UPSTREAM_TIMEOUT_SECONDS=180

# NVIDIA's OpenAI-compatible endpoints are translated to AutoGPT's model aliases.
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
NVIDIA_SMART_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_FAST_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Pin the reviewed MIT AutoGPT Classic source revision.
AUTOGPT_COMMIT=601093ddfe23a3d58a9c8f4a208bd49b203ee612

# VPS only: point this hostname's A/AAAA record to the VPS.
RUNNER_DOMAIN=autogpt-primary.example.com

# Windows only: create a Cloudflare Tunnel public hostname that targets
# http://adapter:8080, then paste its token locally.
CLOUDFLARE_TUNNEL_TOKEN=
