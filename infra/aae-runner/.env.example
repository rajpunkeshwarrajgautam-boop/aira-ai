# Never commit real values. Use distinct random tokens for AIRA->AAE and runner->sandbox.
OPENAI_API_KEY=
AAE_API_TOKEN=
# Bind this runner to one AIRA user id. Do not list multiple users on a shared workspace.
AAE_ALLOWED_OWNER_ID=
AAE_SANDBOX_TOKEN=
AAE_MODEL=gpt-5.6-sol
AAE_ALLOW_FILE_WRITES=true
AAE_ALLOW_SHELL=true
AAE_ENABLE_WEB_SEARCH=true
AAE_MAX_TURNS=40
AAE_SHELL_TIMEOUT_SECONDS=120
