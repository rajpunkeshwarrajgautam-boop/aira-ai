# AIRA runtime edge.
#
# Terminates TLS for every Vercel-facing runtime service on one host and
# reverse-proxies to loopback-only worker ports. Upstream authentication remains
# mandatory; the edge additionally refuses paths AIRA never calls.
{
	email {$AIRA_ACME_EMAIL}
	admin off
}

(hardened) {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Cross-Origin-Resource-Policy "same-origin"
	}
	request_body {
		max_size 24MB
	}
}

# --- Foundation control plane -------------------------------------------------
{$AIRA_CONTROL_HOST} {
	import hardened

	handle /healthz {
		reverse_proxy 127.0.0.1:{$AIRA_CONTROL_PORT}
	}

	handle /v1/admit {
		reverse_proxy 127.0.0.1:{$AIRA_CONTROL_PORT}
	}

	handle /v1/release {
		reverse_proxy 127.0.0.1:{$AIRA_CONTROL_PORT}
	}

	handle /v1/providers/* {
		reverse_proxy 127.0.0.1:{$AIRA_CONTROL_PORT}
	}

	handle /v1/jobs/enqueue {
		reverse_proxy 127.0.0.1:{$AIRA_CONTROL_PORT}
	}

	handle {
		respond 404
	}
}

# --- Python sandbox gateway ---------------------------------------------------
{$AIRA_SANDBOX_HOST} {
	import hardened

	handle /healthz {
		reverse_proxy 127.0.0.1:{$AIRA_SANDBOX_PORT}
	}

	handle /v1/execute {
		reverse_proxy 127.0.0.1:{$AIRA_SANDBOX_PORT}
	}

	handle {
		respond 404
	}
}

# --- Browser worker -----------------------------------------------------------
# Session creation/actions remain bearer-authenticated by the worker. The edge
# publishes only the health endpoint and the versioned session API.
{$AIRA_BROWSER_HOST} {
	import hardened

	handle /healthz {
		reverse_proxy 127.0.0.1:{$AIRA_BROWSER_PORT}
	}

	handle /v1/sessions* {
		reverse_proxy 127.0.0.1:{$AIRA_BROWSER_PORT}
	}

	handle {
		respond 404
	}
}

# --- DeerFlow Gateway ---------------------------------------------------------
{$AIRA_DEERFLOW_HOST} {
	import hardened

	handle /docs* {
		respond 404
	}

	handle /redoc* {
		respond 404
	}

	handle /openapi.json {
		respond 404
	}

	handle /health {
		reverse_proxy 127.0.0.1:{$AIRA_DEERFLOW_PORT}
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:{$AIRA_DEERFLOW_PORT}
	}

	handle {
		respond 404
	}
}

# --- AutoGPT primary ----------------------------------------------------------
{$AIRA_AUTOGPT_PRIMARY_HOST} {
	import hardened

	handle /external-api/* {
		reverse_proxy 127.0.0.1:{$AIRA_AUTOGPT_PRIMARY_PORT}
	}

	handle {
		respond 404
	}
}

# --- AutoGPT secondary --------------------------------------------------------
{$AIRA_AUTOGPT_SECONDARY_HOST} {
	import hardened

	handle /external-api/* {
		reverse_proxy 127.0.0.1:{$AIRA_AUTOGPT_SECONDARY_PORT}
	}

	handle {
		respond 404
	}
}
