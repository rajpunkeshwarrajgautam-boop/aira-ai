    "AIRA_ALLOWED_INFERENCE_REGIONS",
    "AIRA_PROVIDER_REGIONS_JSON",
    "MULTIMODAL_INGESTION_ENABLED",
    "ADVANCED_MULTIMODAL_ENABLED",
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "AIRA_KNOWLEDGE_BUCKET",
    "AIRA_KNOWLEDGE_WORKER_TOKEN",
