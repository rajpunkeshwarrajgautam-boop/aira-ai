    "NVIDIA_CHAT_MODEL",
    "NVIDIA_CHAT_MODEL_FALLBACKS",
    "OPENAI_API_KEY",
    "OPENAI_CHAT_MODEL",
    "npm_lifecycle_event",
    "CASHFREE_ENV",
    "CASHFREE_CLIENT_ID",
    "CASHFREE_CLIENT_SECRET",
    "CASHFREE_WEBHOOK_SECRET",
    "CASHFREE_API_VERSION",
    "CASHFREE_PRO_PLAN_ID",
    "CASHFREE_TEAM_PLAN_ID",
    "CASHFREE_PRO_PLAN_TYPE",
    "CASHFREE_TEAM_PLAN_TYPE",
    "CASHFREE_AUTH_AMOUNT",
    "CASHFREE_AUTH_REFUND",
    "CASHFREE_AUTH_TIME_MIN",
    "BILLING_CHECKOUT_RETURN_URL",
    "DEERFLOW_AGENT_ENABLED",
    "DEERFLOW_API_BASE_URL",
    "DEERFLOW_INTERNAL_AUTH_TOKEN",
    "DEERFLOW_MODEL_NAME",
    "DEERFLOW_THINKING_ENABLED",
    "DEERFLOW_PLAN_MODE",
    "DEERFLOW_REQUEST_TIMEOUT_MS",
    "DEERFLOW_HEALTH_TIMEOUT_MS",
    "AUTOGPT_AGENT_ENABLED",
    "AUTOGPT_API_BASE_URL",
    "AUTOGPT_API_KEY",
    "AUTOGPT_PRIMARY_API_BASE_URL",
    "AUTOGPT_PRIMARY_API_KEY",
    "AUTOGPT_SECONDARY_API_BASE_URL",
    "AUTOGPT_SECONDARY_API_KEY",
    "AUTOGPT_GRAPH_ID",
    "AUTOGPT_GRAPH_VERSION",
    "AUTOGPT_INPUT_NODE_ID",
    "AUTOGPT_INPUT_FIELD",
    "AUTOGPT_REQUEST_TIMEOUT_MS",
    "AUTOGPT_HEALTH_TIMEOUT_MS",
    "AUTOGPT_REQUIRE_FOUNDATION_STACK",
    "FOUNDATION_CONTROL_PLANE_ENABLED",
    "FOUNDATION_CONTROL_PLANE_REQUIRED",
