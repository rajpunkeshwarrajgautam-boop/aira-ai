    "AIRA_EMBEDDING_MODEL",
    "AIRA_EMBEDDING_API_KEY",
    "AIRA_EMBEDDING_BASE_URL",
    "GRAPH_MEMORY_ENABLED",
    "MEMORY_CONSOLIDATION_ENABLED",
    "ADAPTIVE_REASONING_ENABLED",
    "AIRA_SAFETY_GATEWAY_ENABLED",
    "AIRA_SAFETY_GATEWAY_REQUIRED",
    "AIRA_SAFETY_GATEWAY_MODE",
    "AIRA_SAFETY_GATEWAY_URL",
    "AIRA_SAFETY_GATEWAY_TOKEN",
    "AIRA_SAFETY_GATEWAY_TIMEOUT_MS",
